TVH_URL=http://tvheadend.example:9981
TVH_USER=mcp
TVH_PASS=replace-locally
TVH_AUTH=digest
TVH_VERIFY_SSL=true
TVH_TIMEOUT=30
TVH_TIMEZONE=Europe/Berlin
# Optional: block every write while exploring an existing installation.
TVH_READ_ONLY=true
# Optional absolute persistent folder for tuner-isolation crash recovery journals.
# TVH_STATE_DIR=/absolute/path/tvheadend-mcp-state
